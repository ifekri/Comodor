{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist/types",
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "react",
      "react-dom",
      "vite/client"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts"
  ],
  "references": [
    {
      "path": "../../packages/protocol"
    },
    {
      "path": "../../packages/client"
    },
    {
      "path": "../../packages/commands"
    },
    {
      "path": "../../packages/modes"
    },
    {
      "path": "../../packages/questions"
    },
    {
      "path": "../../packages/design-tokens"
    },
    {
      "path": "../../packages/session"
    }
  ]
}
