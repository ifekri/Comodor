{
  // The site, as static assets on Workers — and the GitHub App's endpoints.
  //
  // This was assets-only, and the reason still holds: Next exports 85 files
  // and nothing about serving them needs code to run, so Cloudflare serves
  // them free and unlimited. A script in front of every request would put a
  // marketing page behind the free tier's daily ceiling for nothing.
  //
  // So the script is not in front of every request. `run_worker_first` below
  // names one prefix, and only requests under it reach the code in
  // `workers/site/index.js`. Somebody reading the page never touches it and
  // still costs nothing.
  //
  // Those four endpoints have to be here, and could not be anywhere else: a
  // GitHub App authenticates by signing with a private key, and that key
  // cannot live in a static file or on every user's machine. It is a
  // Cloudflare secret this Worker reads and nothing else does.
  //
  // Build it first:
  //
  //   NEXT_STATIC_EXPORT=1 npm run build
  //   npx wrangler deploy
  //
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comodor-site",
  "compatibility_date": "2026-08-28",
  "main": "workers/site/index.js",

  "assets": {
    "directory": "./out",

    // How the script serves a file. Without it `env.ASSETS` is undefined and
    // anything reaching the fallthrough would answer 500 instead of the page.
    "binding": "ASSETS",

    // The only prefix the script sees. Everything else goes straight to the
    // asset server — which is what keeps the site free and unmetered.
    "run_worker_first": ["/api/integrations/github/*"],

    // Next writes `index.html` into each route's directory and links to the
    // route without one. `auto-trailing-slash` serves `/about/index.html` for
    // both `/about` and `/about/`, which is what those links expect.
    "html_handling": "auto-trailing-slash",

    // Anything unmatched gets the exported 404 page with a 404 status, rather
    // than the single-page-app behaviour of returning index.html and 200 for
    // every typo — which tells a crawler that a mistyped URL is a real page.
    "not_found_handling": "404-page"
  },

  // Routes rather than Custom Domains, and not by preference.
  //
  // A Custom Domain is the tidier mechanism — it owns the DNS record and the
  // certificate — but it refuses to attach to a hostname that already has
  // records, and the apex still carries the four A records that pointed at
  // GitHub Pages. Deleting those needs a DNS-editing credential, which no
  // Workers token has: `wrangler login` tops out at `zone:read`.
  //
  // A route does not care. It intercepts at the edge before the origin is
  // dialled, so those A records are never followed and Pages never serves a
  // byte. The switch is atomic and there is no window with no site.
  //
  // The one thing to know: the records still *say* GitHub Pages. Remove these
  // routes and traffic silently falls back to it rather than breaking, which
  // is a confusing way to find out. Once the apex records are gone these
  // should become `custom_domain: true` entries.
  "routes": [
    { "pattern": "comodor.ai/*", "zone_name": "comodor.ai" },
    { "pattern": "www.comodor.ai/*", "zone_name": "comodor.ai" }
  ],

  // Where a finished connection waits for the terminal that started it.
  //
  // One object per flow, addressed by the nonce inside the flow's signed
  // state, holding one small result for ten minutes and then deleting itself.
  // It is not a database of installations: the authoritative record of a
  // connection is the config file and the private key on the machine that
  // made it, and nothing here outlives its own alarm.
  //
  // A Durable Object rather than KV because the read has to see the write.
  // The browser finishes in one colo and the terminal polls from another,
  // seconds later; KV is eventually consistent and the poll would miss it,
  // which looks exactly like the flow hanging.
  "durable_objects": {
    "bindings": [
      { "name": "CONNECTION_FLOW", "class_name": "ConnectionFlow" }
    ]
  },

  // Durable Objects need a migration to come into existence. `new_sqlite_classes`
  // rather than `new_classes`: SQLite-backed objects are the current default
  // for new namespaces and are what the free plan offers.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ConnectionFlow"] }
  ],

  "observability": {
    "enabled": true
  }
}
