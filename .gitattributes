# Normalise to LF in the repository. Without this, a clone on Windows can hand
# install.sh back with CRLF endings, and `#!/bin/sh\r` fails as "bad
# interpreter" — a confusing break in the one file that must always run.
* text=auto eol=lf

*.sh    text eol=lf
*.ps1   text eol=crlf

*.png   binary
*.jpg   binary
*.ico   binary
*.woff  binary
*.woff2 binary
