# Headers for the static host.
#
# The installers are the reason this file exists. Served by extension they
# arrive as `application/x-sh` and `application/octet-stream`, which a browser
# downloads rather than shows — so anybody who wants to read the script before
# piping it into their shell, which is exactly the person we want to encourage,
# gets a file in their downloads folder instead of the source.

/install.sh
  Content-Type: text/plain; charset=utf-8
  X-Content-Type-Options: nosniff

/install.ps1
  Content-Type: text/plain; charset=utf-8
  X-Content-Type-Options: nosniff

# Hashed filenames, so they can never go stale: a new build produces new names.
# GitHub Pages capped everything at ten minutes and could not be told otherwise,
# which meant re-downloading 700 KB of unchanged JavaScript all day.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Icons, the social card and the one SVG the page draws. None of them are
# content-hashed, so they were revalidated on every visit — 837 KB of files
# that change perhaps once a year, asked about every time somebody arrives.
#
# `stale-while-revalidate` is what makes a long TTL safe here: the browser
# shows the copy it has immediately and refreshes it in the background, so a
# replaced icon appears on the next visit rather than in a week. Without it a
# week-long TTL would mean a week of the old one.
/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/site.webmanifest
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/browserconfig.xml
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# The page itself is not hashed, so it is revalidated — cheap when unchanged,
# and a deploy is visible immediately rather than after an hour.
/
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
